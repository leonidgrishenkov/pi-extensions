{
  "name": "pi-extensions",
  "version": "1.0.0",
  "description": "Personal pi coding agent extensions, themes, and prompts",
  "keywords": [
    "pi-package"
  ],
  "private": true,
  "scripts": {
    "lint": "eslint . --ext .ts",
    "lint:md": "markdownlint 'prompts/**/*.md'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:themes": "tsx scripts/validate-themes.ts",
    "audit:prod": "npm audit --omit=dev --audit-level=low",
    "audit:all": "npm audit --audit-level=moderate",
    "ci": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run validate:themes && npm run lint:md && npm run audit:prod && npm run audit:all"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0",
    "turndown": "7.2.4"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.79.10",
    "@earendil-works/pi-coding-agent": "0.79.10",
    "@earendil-works/pi-tui": "0.79.10",
    "@types/turndown": "5.0.5",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "markdownlint-cli": "^0.49.0",
    "prettier": "^3.9.3",
    "tsx": "^4.22.4",
    "typebox": "^1.3.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "@earendil-works/pi-tui": "0.79.10",
    "@earendil-works/pi-ai": "0.79.10",
    "fast-uri": "^3.1.4"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "themes": [
      "./themes"
    ],
    "prompts": [
      "./prompts"
    ]
  }
}
